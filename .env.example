# Copy this file to .env and fill in the values. Never commit .env.

# Gemini API key from https://aistudio.google.com/app/apikey
# The key is read on the server only and is never sent to the browser.
GEMINI_API_KEY=
# Optional: OAuth Client ID for "Sign in with Google". Defaults to the project's ID.
# Set to an empty value to hide the Google button.
GOOGLE_CLIENT_ID=472558590499-7rrcapd4aeq5ccu27h2374ggoefnikj9.apps.googleusercontent.com

# Public URL of the site. Passkeys only work on this exact origin, so set it to http://localhost:5000 for local development.
SITE_URL=https://studysphere-hub.vercel.app
# Cloudflare Turnstile on login and register. The site key is public (default set in config).
# The secret key is server-only. Turnstile is active only when both are set.
TURNSTILE_SITE_KEY=0x4AAAAAAGDmnUDGhRim2PYn
TURNSTILE_SECRET_KEY=
# Optional: comma-separated hostnames allowed in Turnstile responses. Defaults to the SITE_URL host.
# Add localhost here for local development, and only if the widget's domains include it.
# TURNSTILE_HOSTNAMES=studysphere-hub.vercel.app

# Optional: override the model used for quizzes, flashcards and the assistant.
GEMINI_MODEL=gemini-3.6-flash

# Long random string used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Optional: defaults to instance/studysphere.db (SQLite).
# DATABASE_URL=sqlite:///studysphere.db

# Set to 1 when serving over HTTPS so cookies are sent only on secure connections.
SESSION_COOKIE_SECURE=0

# Development server options (used by run.py).
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
