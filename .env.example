# Copy this file to .env and fill in the values. Never commit .env.

# Gemini API key from https://aistudio.google.com/app/apikey
# The key is read on the server only and is never sent to the browser.
GEMINI_API_KEY=
# Optional: override the model used for quizzes, flashcards and the assistant.
GEMINI_MODEL=gemini-3.6-flash

# Long random string used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Optional: defaults to instance/studysphere.db (SQLite).
# DATABASE_URL=sqlite:///studysphere.db

# Set to 1 when serving over HTTPS so cookies are sent only on secure connections.
SESSION_COOKIE_SECURE=0

# Development server options (used by run.py).
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
